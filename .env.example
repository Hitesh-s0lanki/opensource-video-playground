# ==========================================================================
#  vidgen - environment configuration
# ==========================================================================
#
#  Copy this file to `.env` and edit it:
#
#      copy .env.example .env
#
#  `.env` is gitignored; `.env.example` is committed as the documented
#  template. Every setting below is OPTIONAL - the app runs with none of
#  them set. A real environment variable always overrides the value here.
#
#  Settings are read once at import, so restart the app after changing them.
# ==========================================================================


# --------------------------------------------------------------------------
#  WHERE MODEL WEIGHTS ARE CACHED
# --------------------------------------------------------------------------
#  Default: <project>/models
#
#  This is the most important setting. Video checkpoints are 7-15 GB each,
#  and the full catalogue is roughly 58 GB.
#
#  Point this OUTSIDE any cloud-synced folder (OneDrive, Dropbox, Google
#  Drive). If the cache sits inside one, the sync client will try to upload
#  every gigabyte, and files it locks mid-write can corrupt an install.
#
#  Changing this after downloading means the old weights are not found and
#  will be fetched again - move the existing folder first.
#
#  Use forward slashes, or escape backslashes as \\.
#
# VIDGEN_MODEL_DIR=C:/ai-models


# --------------------------------------------------------------------------
#  WHERE RENDERED VIDEOS ARE WRITTEN
# --------------------------------------------------------------------------
#  Default: <project>/outputs
#  Each render writes <name>.mp4 plus a <name>.json metadata sidecar.
#
# VIDGEN_OUTPUT_DIR=D:/renders


# --------------------------------------------------------------------------
#  HUGGING FACE TOKEN
# --------------------------------------------------------------------------
#  Default: unset
#
#  NOT REQUIRED. Every model in this project is publicly downloadable
#  without an account (verified for all seven repositories).
#
#  Anonymous downloads are rate-limited and slower, so a free read token
#  may speed up the initial 7-15 GB fetch. Create one at:
#      https://huggingface.co/settings/tokens
#
#  Treat this like a password. It stays out of git because `.env` is
#  gitignored - never put a real token in `.env.example`.
#
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# --------------------------------------------------------------------------
#  LOGGING
# --------------------------------------------------------------------------
#  Default: INFO.  Use DEBUG when diagnosing a load failure or an OOM.
#
VIDGEN_LOG_LEVEL=INFO


# --------------------------------------------------------------------------
#  MAXIMUM REFERENCE IMAGES PER RENDER
# --------------------------------------------------------------------------
#  Default: 4
#
#  Image-to-video models (LTX, SVD) only ever use the first image. This
#  limit matters for AnimateDiff, which blends multiple references into one
#  style signal through IP-Adapter.
#
VIDGEN_MAX_REFERENCE_IMAGES=4


# --------------------------------------------------------------------------
#  HUGGING FACE HUB BEHAVIOUR
# --------------------------------------------------------------------------
#  Windows cannot create symlinks without Developer Mode or admin rights.
#  huggingface_hub probes for support and falls back to copying, but that
#  probe is unreliable under a filesystem filter driver (OneDrive) and with
#  concurrent download workers - when it guesses wrong the download aborts
#  with "WinError 1314: A required privilege is not held by the client".
#
#  Disabling symlinks makes the copy path unconditional. Blobs are then
#  duplicated into the snapshot directory, so a model occupies roughly twice
#  its download size on disk - the same cost the fallback already paid.
#  Both are set automatically on Windows.
#
HF_HUB_DISABLE_SYMLINKS=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1

#  Work entirely from already-downloaded weights - no network calls at all.
#  Useful offline, but any missing model fails instead of downloading.
#
# HF_HUB_OFFLINE=1

#  Faster Rust-based downloader. Enabled by default in recent hub versions;
#  set to 0 if you hit transfer errors on an unstable connection.
#
# HF_HUB_ENABLE_HF_TRANSFER=1
